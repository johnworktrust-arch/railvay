[Unit]
Description=Enforce CEA VPN whitelist qualification gate
After=network-online.target docker.service marzban.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/ceavpn/qualify-whitelist-ingress.sh enforce

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/root /run /etc/ufw /lib/ufw /var/lib/ufw /var/www/ceavpn-whitelist
