[Unit]
Description=CEA VPN subscription status proxy
Documentation=https://github.com/Gozargah/Marzban
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
DynamicUser=yes
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=VPN_BOT_USERNAME=ceavpn_bot
ExecStart=/usr/bin/python3 /opt/ceavpn/subscription_proxy.py
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:8010
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
